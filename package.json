{
  "name": "avis",
  "version": "4.6.0",
  "description": "AVIS - Avel Intelligence Services: Multi-AI Orchestration Platform",
  "main": "main.js",
  "author": "Avel Productions LLC",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "pack": "electron-builder --win --dir",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.avelproductions.avis",
    "productName": "AVIS - Avel Intelligence Services",
    "copyright": "Copyright © 2026 Avel Productions LLC",
    "directories": {
      "output": "C:/Users/anyaj/Desktop/AVIS-Installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "clients/**/*",
      "node_modules/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "anyaji",
      "repo": "AVIS-Repo"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "AVIS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@google/generative-ai": "^0.21.0",
    "@mendable/firecrawl-js": "^4.18.0",
    "axios": "^1.7.0",
    "docx": "^9.6.1",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "gsap": "^3.14.2",
    "highlight.js": "^11.10.0",
    "koffi": "^2.16.2",
    "mammoth": "^1.8.0",
    "marked": "^15.0.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "pptxgenjs": "^4.0.1",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  }
}
