{
  "manifest_version": 3,
  "name": "AVIS Chrome MCP",
  "version": "1.0.0",
  "description": "Browser automation bridge for AVIS Intelligence Services",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "offscreen": {
    "reasons": ["LOCAL_STORAGE"],
    "justification": "Maintains persistent WebSocket connection to AVIS"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
